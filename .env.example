# --- Frontend (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: absolute URL of the backend when not co-hosted (e.g. https://api.example.com).
# Leave blank in dev — Vite proxies /api to http://localhost:3001.
VITE_API_URL=

# --- Backend (server/) ---
# Service role key from Supabase project settings (NEVER expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Password to log into /synapsea-admin. Pick something long.
SYNAPSEA_ADMIN_PASSWORD=

# Random 64+ char string used to sign admin JWTs.
JWT_SECRET=

# Base URL for UAZAPI. Default is the Synapsea instance.
UAZAPI_BASE_URL=https://synapsea.uazapi.com

# CORS origin for the server. Use your web origin in prod, "*" in dev.
CORS_ORIGIN=*
